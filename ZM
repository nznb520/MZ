-- ====== 接上一段，定义轮廓方案应用函数和下拉框 ======

-- 当前选中的轮廓方案名称（默认为第一个）
local currentOutlineScheme = next(COLOR_SCHEMES)  -- 取第一个方案的键名

-- 应用轮廓方案（将方案的首个颜色设为轮廓颜色）
local function applyOutlineScheme(schemeName)
    local scheme = COLOR_SCHEMES[schemeName]
    if scheme then
        local keys = scheme.ColorSequence.Keypoints
        if #keys > 0 then
            ThemeOutline = keys[1].Value:ToHex()
            updateTheme()
        end
    end
end

function updateTheme()
    WindUI:AddTheme({
        Name = currentThemeName,
        Accent = ThemeAccent,
        Outline = ThemeOutline,
        Text = ThemeText,
        Placeholder = ThemePlaceholderText
    })
    WindUI:SetTheme(currentThemeName)
end

