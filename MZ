local function ShowVideoPopup()
    local videoGui = Instance.new("ScreenGui")
    videoGui.Name = "VideoPopup"
    videoGui.IgnoreGuiInset = true
    videoGui.Parent = game.CoreGui

    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, 0, 1, 0)
    mainFrame.BackgroundColor3 = Color3.new(0, 0, 0)
    mainFrame.BackgroundTransparency = 0
    mainFrame.Parent = videoGui

    -- 尝试使用 WebView（适用于 Synapse X、Krnl 等支持 WebView 的注入器）
    local webView = nil
    local webViewSupported = false

    if syn and syn.web_view then
        webView = syn.web_view
        webViewSupported = true
    elseif Krnl and Krnl.web_view then
        webView = Krnl.web_view
        webViewSupported = true
    elseif webview then
        webView = webview
        webViewSupported = true
    end

    if webViewSupported then
        -- 创建 WebView 覆盖全屏，设置横屏参数（通过 CSS 和视频参数）
        local videoUrl = "https://cdn.jsdelivr.net/gh/nznb520/nznb@main/VID_20260724_215920.mp4"
        -- 嵌入 HTML 视频，自动播放，无控制条，强制全屏（通过 CSS）
        local html = [[
            <html>
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
                <style>
                    body { margin: 0; overflow: hidden; background: black; }
                    video { width: 100vw; height: 100vh; object-fit: fill; display: block; }
                </style>
            </head>
            <body>
                <video id="vid" src="]] .. videoUrl .. [[" autoplay muted playsinline></video>
                <script>
                    var vid = document.getElementById('vid');
                    vid.play();
                    // 尝试请求全屏（部分浏览器需要用户手势，但这里无法保证）
                    if (vid.requestFullscreen) {
                        vid.requestFullscreen().catch(()=>{});
                    }
                </script>
            </body>
            </html>
        ]]
        local webViewInstance = webView(html, 0, 0, 0, 0) -- 参数可能因注入器而异
        -- 可能需要设置位置和大小，此处假设 webView 默认占满屏幕
        -- 一些注入器使用 web_view:SetSize 等，这里先简单处理
        webViewInstance.Parent = mainFrame
        -- 尝试设置尺寸
        if webViewInstance.Size then
            webViewInstance.Size = UDim2.new(1, 0, 1, 0)
        end
        if webViewInstance.Position then
            webViewInstance.Position = UDim2.new(0, 0, 0, 0)
        end
        -- 保存引用以便关闭
        videoGui.WebView = webViewInstance

        -- 添加关闭按钮（右上角）
        local closeBtn = Instance.new("TextButton")
        closeBtn.Size = UDim2.new(0, 60, 0, 40)
        closeBtn.Position = UDim2.new(1, -70, 0, 10)
        closeBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        closeBtn.BorderSizePixel = 0
        closeBtn.Text = "关闭"
        closeBtn.TextColor3 = Color3.new(1, 1, 1)
        closeBtn.Font = Enum.Font.SourceSansBold
        closeBtn.TextScaled = true
        closeBtn.Parent = mainFrame

        closeBtn.MouseButton1Click:Connect(function()
            if videoGui then
                if videoGui.WebView and videoGui.WebView.Destroy then
                    videoGui.WebView:Destroy()
                end
                videoGui:Destroy()
            end
        end)
    else
        -- 不支持 WebView，则使用普通 GUI 显示提示并打开浏览器
        local hintFrame = Instance.new("Frame")
        hintFrame.Size = UDim2.new(1, 0, 1, 0)
        hintFrame.BackgroundTransparency = 0.8
        hintFrame.BackgroundColor3 = Color3.new(0, 0, 0)
