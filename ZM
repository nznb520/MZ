Tabs.ESPTab:Toggle({
    Title = "透视玩家",
    Desc = "透视所有玩家模型",
    Value = false,
    Callback = function(state)
        ESPEnabled = state
        
        if state then
            -- 清除旧的连接
            for _, connection in pairs(ESPConnections) do
                if connection then
                    connection:Disconnect()
                end
            end
            ESPConnections = {}
            
            -- 为现有玩家创建高亮
            local function AddHighlightToPlayer(player)
                if player ~= game.Players.LocalPlayer and player.Character then
                    local highlight = Instance.new("Highlight")
                    highlight.FillColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                    ESPHighlights[player] = highlight
                end
            end
            
            for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                AddHighlightToPlayer(player)
            end
            
            -- 监听新玩家加入
            local playerAddedConnection = game:GetService("Players").PlayerAdded:Connect(function(player)
                local characterAddedConnection = player.CharacterAdded:Connect(function(character)
                    if ESPEnabled then
                        wait(1) -- 等待角色加载
                        local highlight = Instance.new("Highlight")
                        highlight.FillColor = Color3.fromRGB(255, 255, 255)
                        highlight.FillTransparency = 0.5
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.OutlineTransparency = 0
                        highlight.Parent = character
                        ESPHighlights[player] = highlight
                    end
                end)
                
                ESPConnections[player] = characterAddedConnection
            end)
            
            ESPConnections["PlayerAdded"] = playerAddedConnection
            
            -- 监听玩家离开
            local playerRemovingConnection = game:GetService("Players").PlayerRemoving:Connect(function(player)
                if ESPHighlights[player] then
                    ESPHighlights[player]:Destroy()
                    ESPHighlights[player] = nil
                end
                
                if ESPConnections[player] then
                    ESPConnections[player]:Disconnect()
                    ESPConnections[player] = nil
                end
            end)
            
            ESPConnections["PlayerRemoving"] = playerRemovingConnection
        else
            -- 移除所有高亮效果
            for _, highlight in pairs(ESPHighlights) do
                if highlight then
                    highlight:Destroy()
                end
            end
            ESPHighlights = {}
            
            -- 清除所有连接
            for _, connection in pairs(ESPConnections) do
                if connection then
                    connection:Disconnect()
                end
            end
            ESPConnections = {}
        end
    end
})

