-- 绘制射线功能
local RayDrawingEnabled = false
local RayLines = {} -- 存储射线对象
local RayConnections = {} -- 用于存储射线相关的连接

-- 获取屏幕尺寸
local function GetScreenSize()
    return workspace.CurrentCamera.ViewportSize
end

-- 创建射线绘制
local function CreateRayDrawing(player, character)
    if not character or not character.Parent then return end
    
    local screenSize = GetScreenSize()
    local startY = screenSize.Y / 2 -- 固定为屏幕中心
    
    -- 创建射线
    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Color = Color3.fromRGB(255, 255, 255) -- 白色
    line.From = Vector2.new(screenSize.X / 2, startY)
    
    RayLines[player] = line
    
    -- 更新射线位置的函数
    local function UpdateRay()
        if not RayDrawingEnabled or not character or not character.Parent then
            if RayLines[player] then
                RayLines[player]:Remove()
                RayLines[player] = nil
            end
            return
        end
        
        -- 获取玩家身体部位
        local torso = character:FindFirstChild("UpperTorso") or 
                     character:FindFirstChild("HumanoidRootPart") or
                     character:FindFirstChild("Torso")
        
        if torso then
            -- 将3D位置转换为2D屏幕位置
            local camera = workspace.CurrentCamera
            local torsoPosition = torso.Position
            local torsoScreenPos, torsoVisible = camera:WorldToViewportPoint(torsoPosition)
            
            if torsoVisible then
                local screenPos = Vector2.new(torsoScreenPos.X, torsoScreenPos.Y)
                local line = RayLines[player]
                if line then
                    line.From = Vector2.new(screenSize.X / 2, screenSize.Y / 2) -- 固定起点为屏幕中心
                    line.To = screenPos
                    line.Visible = true
                end
            else
                -- 如果玩家不在屏幕内，隐藏射线
                if RayLines[player] then
                    RayLines[player].Visible = false
                end
            end
        end
    end
    
    -- 创建每帧更新的连接
    local renderConnection = game:GetService("RunService").RenderStepped:Connect(UpdateRay)
    RayConnections[player] = renderConnection
end

-- 为所有玩家创建射线
local function CreateRaysForAllPlayers()
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player ~= game.Players.LocalPlayer and player.Character then
            CreateRayDrawing(player, player.Character)
        end
    end
end

-- 清除所有射线
local function ClearAllRays()
    for player, line in pairs(RayLines) do
        if line then
            line:Remove()
        end
    end
    RayLines = {}
    
    for player, connection in pairs(RayConnections) do
        if connection then
            connection:Disconnect()
        end
    end
    RayConnections = {}
end

-- 开启绘制射线开关
local RayToggle = Tabs.ESPTab:Toggle({
    Title = "开启绘制射线",
    Desc = "为所有玩家绘制指向身体的射线（固定从屏幕中心开始）",
    Value = false,
    Callback = function(state)
        RayDrawingEnabled = state
        
        if state then
            -- 清除旧的连接
            for _, connection in pairs(RayConnections) do
                if connection then
                    connection:Disconnect()
                end
            end
            RayConnections = {}
            
            -- 为已有玩家创建射线
            CreateRaysForAllPlayers()
            
            -- 监听新玩家加入
            local playerAddedConnection = game:GetService("Players").PlayerAdded:Connect(function(player)
                local characterAddedConnection = player.CharacterAdded:Connect(function(character)
                    wait(1) -- 等待角色加载
                    if RayDrawingEnabled then
                        CreateRayDrawing(player, character)
                    end
                end)
                
                RayConnections[player] = characterAddedConnection
            end)
            
            RayConnections["PlayerAdded"] = playerAddedConnection
            
            -- 监听玩家离开
            local playerRemovingConnection = game:GetService("Players").PlayerRemoving:Connect(function(player)
                if RayLines[player] then
                    RayLines[player]:Remove()
                    RayLines[player] = nil
                end
                
                if RayConnections[player] then
                    RayConnections[player]:Disconnect()
                    RayConnections[player] = nil
                end
            end)
            
            RayConnections["PlayerRemoving"] = playerRemovingConnection
        else
